{
  "version": 2,
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/design",
      "destination": "/design-preview.html"
    },
    {
      "source": "/((?!assets/|favicon.ico|vite.svg).*)",
      "destination": "/index.html"
    }
  ]
}
