# ─────────────────────────────────────────────────────────────────────────────
# Gurey Group — Environment Variables Template
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to git — it is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/?appName=YOUR_APP

# ─── Backend JWT Secrets ──────────────────────────────────────────────────────
# Generate secure random values: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_64_CHAR_RANDOM_HEX_STRING

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5050
NODE_ENV=development
# Used for invitation links and as the CORS allow-list entry.
FRONTEND_URL=http://localhost:3000
# Additional allowed browser origin in production (e.g. https://app.example.com)
PUBLIC_APP_URL=

# ─── Firebase (backend identity verification) ────────────────────────────────
# REQUIRED. The API verifies every Firebase ID token against Google's public
# signing certificates and checks it was issued for this project. Without it,
# owner sign-in is rejected. No service-account key is needed.
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID

# ─── Firebase Web SDK ─────────────────────────────────────────────────────────
# REQUIRED — there are no longer any hardcoded fallbacks in the source.
# Find these in Firebase Console → Project Settings → Your apps
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.firebaseio.com

# ─── Frontend API Base URL ────────────────────────────────────────────────────
# In local development the browser should call /api, and Vite proxies it to the
# backend. This avoids hardcoded localhost backend URLs in browser code.
VITE_API_URL=/api
VITE_DEV_API_TARGET=http://127.0.0.1:5050

# ─── AI Assistant Providers ─────────────────────────────────────────────────
# Configure one provider on the backend. Do not expose provider keys as VITE_*.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional official external search service endpoint for future AI tools.
# Do not scrape Google directly; use a supported search API provider.
SEARCH_API_URL=
SEARCH_API_KEY=

# ─── Email delivery (verification links) ──────────────────────────────────────
# Optional. Without it, verification links are written to the server log and
# returned to the client in non-production so the flow stays testable.
SMTP_URL=
MAIL_FROM=Gurey Group <no-reply@yourdomain.com>
